{
  "name": "proofpak",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --use-env-proxy node_modules/next/dist/bin/next dev",
    "build": "node --use-env-proxy node_modules/next/dist/bin/next build",
    "start": "node --use-env-proxy node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:db": "bash scripts/test-database.sh",
    "test:e2e": "playwright test",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"*.{ts,json,mjs}\"",
    "doctor": "node --use-env-proxy scripts/check-services.mjs"
  },
  "dependencies": {
    "@reown/appkit": "1.8.24",
    "@reown/appkit-adapter-solana": "1.8.24",
    "@solana/kit": "^8.4.0",
    "@solana/wallet-standard-features": "^1.5.0",
    "@solana/web3.js": "^3.0.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@wallet-standard/app": "^1.1.1",
    "@wallet-standard/features": "^1.1.1",
    "buffer": "^6.0.3",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "solana-web3-legacy": "npm:@solana/web3.js@1.98.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  }
}
