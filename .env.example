# Supabase Project Settings > API. Publishable key is safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Needed ONLY to persist verified blockchain proofs. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Set to your deployed URL; add /auth/callback to Supabase Auth redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Both RPCs must point to Solana DEVNET. Server key-bearing URLs must stay server-only.
SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Server-only secret for Vercel's scheduled read-only-chain payment reconciliation.
# Generate a long random value in Vercel settings at release. Never prefix NEXT_PUBLIC_.
CRON_SECRET=
